{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-extensions:spec:memx:0.1.0",
  "title": "MEMX 0.1.0 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["memx_version", "exported_at", "profiles"],
  "properties": {
    "memx_version": { "const": "0.1.0" },
    "exported_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application": { "type": "string", "maxLength": 200 },
        "application_version": { "type": "string", "maxLength": 200 },
        "model": { "type": "string", "maxLength": 200 }
      }
    },
    "profiles": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "#/$defs/profile" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "preferences", "coding_profiles", "context_items"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "preferences": { "type": "object" },
        "coding_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "style_guide": { "type": "string", "maxLength": 100000 },
              "formatting": { "type": "object" },
              "examples": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 20000 } }
            }
          }
        },
        "context_items": {
          "type": "array", "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "content", "updated_at", "tags"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 100 },
              "kind": { "enum": ["preference", "project", "fact", "instruction", "workflow", "other"] },
              "content": { "type": "string", "minLength": 1, "maxLength": 200000 },
              "updated_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
              "tags": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 80 } }
            }
          }
        }
      }
    }
  }
}
