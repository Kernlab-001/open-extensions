{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-extensions:spec:wapp:0.1.0",
  "title": "WAPP 0.1.0 manifest",
  "type": "object", "additionalProperties": false,
  "required": ["format", "format_version", "app_id", "name", "app_version", "runtime_min", "entrypoint", "files", "permissions", "network", "security"],
  "properties": {
    "format": { "const": "wapp" }, "format_version": { "const": "0.1.0" },
    "app_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$" }, "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "app_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$" }, "runtime_min": { "type": "string" },
    "entrypoint": { "type": "string", "pattern": "^app/(?!.*(?:^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$" },
    "files": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "byte_length", "sha256", "media_type"], "properties": { "path": { "type": "string" }, "byte_length": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "media_type": { "type": "string" } } } },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "enum": ["storage.sqlite", "clipboard.read", "clipboard.write", "notifications", "camera", "microphone", "geolocation"] } },
    "network": { "type": "object", "additionalProperties": false, "required": ["mode", "allowed_origins"], "properties": { "mode": { "enum": ["deny", "allowlist"] }, "allowed_origins": { "type": "array", "items": { "type": "string", "pattern": "^https://[^/*]+$" } } } },
    "security": { "type": "object", "additionalProperties": false, "required": ["csp", "allow_inline_scripts", "allow_eval", "allow_popups", "external_navigation"], "properties": { "csp": { "type": "string", "minLength": 1 }, "allow_inline_scripts": { "const": false }, "allow_eval": { "const": false }, "allow_popups": { "const": false }, "external_navigation": { "enum": ["deny", "confirm"] } } },
    "storage": { "type": "object", "additionalProperties": false, "required": ["database_id", "seed_path", "schema_version"], "properties": { "database_id": { "type": "string" }, "seed_path": { "const": "storage/seed.sqlite" }, "schema_version": { "type": "string" } } },
    "extensions": { "type": "object" }
  }
}
