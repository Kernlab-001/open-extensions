{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-extensions:spec:stepx:0.1.0",
  "title": "STEPX 0.1.0 document",
  "type": "object", "additionalProperties": false,
  "required": ["format", "format_version", "title", "category", "base_yield", "yield_unit", "ingredients", "steps"],
  "properties": {
    "format": { "const": "stepx" }, "format_version": { "const": "0.1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "category": { "enum": ["recipe", "diy", "repair", "procedure", "other"] },
    "base_yield": { "$ref": "#/$defs/decimal" }, "yield_unit": { "type": "string", "minLength": 1, "maxLength": 80 },
    "conditions": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "array", "null"] } },
    "ingredients": { "type": "array", "items": { "$ref": "#/$defs/ingredient" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "decimal": { "type": "string", "pattern": "^([1-9][0-9]*(\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*)$" },
    "ingredient": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "quantity", "unit"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "quantity": { "$ref": "#/$defs/decimal" }, "unit": { "type": "string", "minLength": 1 }, "scale_mode": { "enum": ["linear", "fixed"] }, "preparation": { "type": "string" } }
    },
    "condition": {
      "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["variable", "operator", "value"], "properties": { "variable": { "type": "string" }, "operator": { "enum": ["eq", "neq", "in", "not_in"] }, "value": { "type": ["string", "number", "boolean", "array", "null"] } } }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["id", "order", "title", "instruction"],
      "properties": {
        "id": { "type": "string" }, "order": { "type": "integer", "minimum": 1 }, "title": { "type": "string" }, "instruction": { "type": "string", "minLength": 1 },
        "ingredient_refs": { "type": "array", "items": { "type": "string" } }, "requires": { "type": "array", "items": { "type": "string" } },
        "timer": { "type": "object", "additionalProperties": false, "required": ["duration_seconds", "label", "start_policy"], "properties": { "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 }, "label": { "type": "string" }, "start_policy": { "enum": ["manual", "on_step_open"] } } },
        "substitutions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["replaces", "replacement", "reason"], "properties": { "replaces": { "type": "string" }, "replacement": { "$ref": "#/$defs/ingredient" }, "reason": { "type": "string" }, "when": { "$ref": "#/$defs/condition" } } } }
      }
    }
  }
}
