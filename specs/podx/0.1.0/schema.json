{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-extensions:spec:podx:0.1.0",
  "title": "PODX 0.1.0 manifest",
  "type": "object", "additionalProperties": false,
  "required": ["format", "format_version", "title", "timebase_hz", "duration_ticks", "tracks", "transcript", "chapters"],
  "properties": {
    "format": { "const": "podx" }, "format_version": { "const": "0.1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "timebase_hz": { "const": 48000 },
    "duration_ticks": { "type": "integer", "minimum": 1 },
    "tracks": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/track" } },
    "transcript": {
      "type": "object", "additionalProperties": false, "required": ["words"],
      "properties": { "words": { "type": "array", "items": { "$ref": "#/$defs/word" } } }
    },
    "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } },
    "speakers": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "locale": { "type": "string" } }, "additionalProperties": false } },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "track": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path", "media_type", "codec", "sample_rate_hz", "channels", "start_tick", "duration_ticks", "sha256", "byte_length"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["voice", "music", "sfx", "ambience", "other"] },
        "path": { "type": "string", "pattern": "^tracks/(?!.*(?:^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$" },
        "media_type": { "type": "string" }, "codec": { "enum": ["opus-ogg", "flac"] },
        "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 384000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 8 },
        "start_tick": { "type": "integer", "minimum": 0 }, "duration_ticks": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "byte_length": { "type": "integer", "minimum": 1 },
        "gain_db": { "type": "number", "minimum": -60, "maximum": 24 }, "language": { "type": "string" }
      }
    },
    "word": {
      "type": "object", "additionalProperties": false,
      "required": ["start_tick", "end_tick", "text"],
      "properties": { "start_tick": { "type": "integer", "minimum": 0 }, "end_tick": { "type": "integer", "minimum": 1 }, "text": { "type": "string", "minLength": 1 }, "track_id": { "type": "string" }, "speaker_id": { "type": "string" }, "confidence_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 } }
    },
    "chapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "start_tick", "end_tick"],
      "properties": { "id": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "start_tick": { "type": "integer", "minimum": 0 }, "end_tick": { "type": "integer", "minimum": 1 }, "description": { "type": "string" } }
    }
  }
}
